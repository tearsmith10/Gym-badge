{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/app/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/app/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/app/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" }
      ]
    }
  ],
  "routes": [
    { "src": "/gymbadge_core.py", "dest": "/api/index.py" },
    { "src": "/gymbadge_content.py", "dest": "/api/index.py" },
    { "src": "/gymbadge_kb.py", "dest": "/api/index.py" },
    { "src": "/server.py", "dest": "/api/index.py" },
    { "src": "/api/index.py", "status": 404 },
    { "src": "/data/(.*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/login", "dest": "/web/login.html" },
    { "src": "/signup", "dest": "/web/signup.html" },
    { "src": "/forgot", "dest": "/web/forgot.html" },
    { "src": "/reset", "dest": "/web/reset.html" },
    { "src": "/verify", "dest": "/web/verify.html" },
    { "src": "/pricing", "dest": "/web/pricing.html" },
    { "src": "/find", "dest": "/web/find.html" },
    { "src": "/gyms", "dest": "/web/gyms.html" },
    { "src": "/trainers", "dest": "/web/trainers.html" },
    { "src": "/coaches", "dest": "/web/coach.html" },
    { "src": "/gym", "dest": "/web/gym.html" },
    { "src": "/coach", "dest": "/web/coach.html" },
    { "src": "/about", "dest": "/web/about.html" },
    { "src": "/reviews", "dest": "/web/reviews.html" },
    { "src": "/faq", "dest": "/web/faq.html" },
    { "src": "/support", "dest": "/web/support.html" },
    { "src": "/download", "dest": "/web/download.html" },
    { "src": "/app-download", "dest": "/web/download.html" },
    { "src": "/get-the-app", "dest": "/web/download.html" },
    { "src": "/account", "dest": "/web/account.html" },
    { "src": "/privacy", "dest": "/web/privacy.html" },
    { "src": "/terms", "dest": "/web/terms.html" }
  ]
}
