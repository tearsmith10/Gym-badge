{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/app/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/app/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self)" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*",     "destination": "/api/index.py" },
    { "source": "/login",        "destination": "/web/login.html" },
    { "source": "/signup",       "destination": "/web/signup.html" },
    { "source": "/forgot",       "destination": "/web/forgot.html" },
    { "source": "/reset",        "destination": "/web/reset.html" },
    { "source": "/verify",       "destination": "/web/verify.html" },
    { "source": "/pricing",      "destination": "/web/pricing.html" },
    { "source": "/find",         "destination": "/web/find.html" },
    { "source": "/gyms",         "destination": "/web/gyms.html" },
    { "source": "/trainers",     "destination": "/web/trainers.html" },
    { "source": "/coaches",      "destination": "/web/coach.html" },
    { "source": "/gym",          "destination": "/web/gym.html" },
    { "source": "/coach",        "destination": "/web/coach.html" },
    { "source": "/about",        "destination": "/web/about.html" },
    { "source": "/reviews",      "destination": "/web/reviews.html" },
    { "source": "/faq",          "destination": "/web/faq.html" },
    { "source": "/support",      "destination": "/web/support.html" },
    { "source": "/account",      "destination": "/web/account.html" },
    { "source": "/privacy",      "destination": "/web/privacy.html" },
    { "source": "/terms",        "destination": "/web/terms.html" }
  ]
}
