{
  "id": "/app/",
  "name": "Gym Badge — Train smarter, earn your badge",
  "short_name": "Gym Badge",
  "description": "The training companion that remembers every set, checks every machine, explains every meal and shows the body you are building.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#121211",
  "theme_color": "#121211",
  "categories": ["health", "fitness", "lifestyle"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "/app/assets/img/icon-192.png?v=20", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/assets/img/icon-512.png?v=20", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/assets/img/icon-maskable-512.png?v=20", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My Routine", "short_name": "Routine", "url": "/app/#/workout" },
    { "name": "The Guides", "short_name": "Guides", "url": "/app/#/exercise" },
    { "name": "My Workout Log", "short_name": "Log", "url": "/app/#/log" },
    { "name": "My Plate Truth", "short_name": "Plate", "url": "/app/#/plate" },
    { "name": "My Trainer", "short_name": "Trainer", "url": "/app/#/trainers" }
  ]
}
